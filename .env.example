# All three platform flags must match; false preserves standalone contracts.
EVENTPIPE_PLATFORM_MODE=false
QUERY_PLATFORM_MODE=false
TRANSFORM_PLATFORM_MODE=false
# Fixed internal identity base URL; no JWT signing secret is needed.
EVENTPIPE_AUTH_URL=http://auth_service:8000
QUERY_AUTH_URL=http://auth_service:8000
# No live GeoIP requests until explicitly enabled.
TRANSFORM_GEO_IP_ENABLED=false
